{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/wiki_hooks.py\" pre 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/wiki_hooks.py\" pre",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/wiki_hooks.py\" post 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/wiki_hooks.py\" post",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
